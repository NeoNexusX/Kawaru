# Database settings
DATABASE_PASSWORD=xxxxxxxxxx

# Redis settings
REDIS_PASSWORD=your_redis_password

# Stable JWT signing key (required for tokens to survive process restarts)
SECRET_KEY=replace-with-a-long-random-string

# Support for Aliyun OSS
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_ROLE_ARN=your_role_arn
OSS_FC_ALGORITHM_TOKEN=XXXXXX # auto-trigger algorithm function token for OSS file
OSS_FC_TIC_TOKEN=XXXXXX # auto-trigger tic function token for OSS file upload
OSS_FC_FEATURE_TOKEN=XXXXXX # auto-trigger feature function token for OSS file 
OSS_FC_RAW_CONVERT_TOKEN=XXXXXX 
OSS_FC_CLUSTERING_TOKEN=XXXXXX # auto-trigger clustering

# FC 回调主服务的验证 Token（所有 FC 函数共用）
FC_CALLBACK_TOKEN=xxxxxxx

# Support for SMTP server
SMTP_PASSWORD=xxxxxx

# Support for LOG
LOG_DIR=kawaru_logs
LOG_LEVEL=info

# Support for config
CONFIG_PATH=config.yaml
REGION_PATH=external/countries-states-cities-database/json/countries.json

# Support for pytest (仅本地直接跑 pytest 时用；CI 不读此文件：
# BASE_URL 由 compose 注入、TEST_USER/TEST_PWD 留空则 conftest 从 api.log 解析首启管理员)
BASE_URL=http://127.0.0.1:8000
TEST_USER=
TEST_PWD=

# Optional local performance-test overrides
PERF_TEST_PASSWORD=
PERF_TEST_RUN_ID=
