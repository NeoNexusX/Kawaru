# Database settings
DATABASE_PASSWORD=xxxxxxxxxx

# Redis settings
REDIS_PASSWORD=your redis passwd

# Support for Aliyun OSS
OSS_ACCESS_KEY_ID=your access key id
OSS_ACCESS_KEY_SECRET=your access key secret
OSS_ROLE_ARN=your role arn
OSS_FC_PACKUP_TOKEN=XXXXXX # auto-compress function token for OSS zip packup
OSS_FC_ALGORITHM_TOKEN=XXXXXX# auto-trigger algorithm function token for OSS file 
OSS_FC_TIC_TOKEN=XXXXXX # auto-trigger tic function token for OSS file upload
OSS_FC_FEATURE_TOKEN=XXXXXX # auto-trigger feature function token for OSS file upload

# Support for MAILGUN server
MAILGUN_API_KEY=your key

# Support for SMTP server
SMTP_PASSWORD=xxxxxx

# Support for LOG
LOG_DIR=kawaru_logs
LOG_LEVEL=info

# Support for config
CONFIG_PATH=config.yaml
REGION_PATH=external/countries-states-cities-database/json/countries.json