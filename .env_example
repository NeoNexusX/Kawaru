# Database settings
DATABASE_PASSWORD=xxxxxxxxxx

# Redis settings
REDIS_PASSWORD=your redis passwd

# Support for Aliyun OSS
OSS_ACCESS_KEY_ID=your access key id
OSS_ACCESS_KEY_SECRET=your access key secret

# Support for MAILGUN server
MAILGUN_API_KEY=your key

# Support for SMTP server
SMTP_PASSWORD=xxxxxx

# Support for LOG
LOG_DIR=kawaru_logs
LOG_LEVEL=info

# Support for config
CONFIG_PATH=config.yaml
REGION_PATH=external/countries-states-cities-database/json/countries.json