# Support for MAILGUN server
MAILGUN_API_KEY=your key
MAILGUN_DOMAIN=yourMAILGUN_DOMAIN

# Support for SMTP
LAST_SMTP_PORT=465 # or 587
LAST_SMTP_USERNAME=example@qq.com
LAST_SMTP_PASSWORD=123456  # For Gmail: 16-character app password (with spaces). For QQ Mail: no spaces.
LAST_SMTP_FROM_EMAIL=example@qq.com
LAST_SMTP_SERVER=smtp.qq.com